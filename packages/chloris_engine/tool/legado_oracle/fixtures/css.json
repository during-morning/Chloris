    "src": "p@text（简介/信息段落）"
  },
  {
    "id": "css-007",
    "kind": "css",
    "rule": ":contains(作者)@text",
    "content": "<div><p>作者：爱潜水的乌贼</p><p>简介：一段文字</p></div>",
    "expect": "伪类 :contains 选择包含『作者』的元素并取文本。",
    "src": "span:contains(作者：)@text（ruleBookInfo.author 源自真实书源）"
  },
  {
    "id": "css-008",
    "kind": "css",
    "rule": "dd:contains(最新章节：) > a@text",
    "content": "<dl><dd>最新章节：<a>第1章 开端</a></dd></dl>",
    "expect": "复合：dd:contains 定位 + 子代 > a 取文本。",
    "src": "dd:contains(最新章节：) > a@text（真实书源 tocUrl/lastChapter）"
  },
  {
    "id": "css-009",
    "kind": "css",
    "rule": "dt:contains(作者)+dd a@text",
    "content": "<dl><dt>作者</dt><dd><a>猫腻</a></dd></dl>",
    "expect": "相邻兄弟 +dd 再取 descendant a 文本。",
    "src": "dt:contains(作者)+dd a@text（真实书源 author 规则）"
  },
  {
    "id": "css-010",
    "kind": "css",
    "rule": "@css:a:contains(下一页)@href",
    "content": "<div><a href=\"/p/2\">下一页</a><a href=\"/p/1\">上一页</a></div>",
    "expect": "@css: 前缀走原生 CSS 选择器，:contains 命中『下一页』取 href。",
    "src": "@css:a:contains(下一页)@href（分页 nextUrl 规则）"
  },
  {
    "id": "css-011",
    "kind": "css",
