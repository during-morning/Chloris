[
  {
    "id": "css-001",
    "kind": "css",
    "rule": "a@text",
    "content": "<div><a>Alpha</a><a>Beta</a><a>Gamma</a></div>",
    "expect": "提取全部 <a> 文本，按文档顺序返回。",
    "src": "基础选择器 a@text（广泛见于 ruleSearch.bookList/name）"
  },
  {
    "id": "css-002",
    "kind": "css",
