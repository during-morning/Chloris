[
  {
    "id": "json-001",
    "kind": "json",
    "rule": "$.name",
    "content": "{\"name\":\"诡秘之主\",\"author\":\"爱潜水的乌贼\"}",
    "expect": "取根级字段 name。",
    "src": "$.name（ruleBookInfo.name）"
  },
  {
    "id": "json-002",
    "kind": "json",
    "rule": "$.data.chapters",
    "content": "{\"data\":{\"chapters\":[\"第1章\",\"第2章\",\"第3章\"]}}",
    "expect": "嵌套路径取数组，换行连接。",
    "src": "$.data.chapters（ruleToc 列表）"
  },
  {
    "id": "json-003",
    "kind": "json",
    "rule": "$.chapters[*]",
    "content": "{\"chapters\":[\"ch1\",\"ch2\",\"ch3\"]}",
    "expect": "通配 [*] 展开数组元素。",
    "src": "$.chapters（既有样例）"
  },
  {
    "id": "json-004",
    "kind": "json",
    "rule": "$.data.list[*].title",
    "content": "{\"data\":{\"list\":[{\"title\":\"甲\"},{\"title\":\"乙\"}]}}",
    "expect": "数组内取每个对象的 title 字段。",
    "src": "$.results.list[*].title（真实书源）"
  },
  {
    "id": "json-005",
    "kind": "json",
    "rule": "$..title",
    "content": "{\"book\":{\"title\":\"主标题\"},\"data\":{\"title\":\"副标题\"}}",
    "expect": "递归下降 $.. 收集所有 title。",
    "src": "$..title（递归路径）"
  },
  {
    "id": "json-006",
    "kind": "json",
    "rule": "$.data.chapters[0]",
    "content": "{\"data\":{\"chapters\":[\"第1章\",\"第2章\"]}}",
    "expect": "数组下标 0 取首个元素。",
    "src": "$.data.chapters[0]（首章）"
  },
  {
    "id": "json-007",
    "kind": "json",
    "rule": "$.data.chapters[1:3]",
    "content": "{\"data\":{\"chapters\":[\"c0\",\"c1\",\"c2\",\"c3\"]}}",
    "expect": "切片 [1:3) 取索引 1、2。",
    "src": "$.data.chapters[1:3]（切片）"
  },
  {
    "id": "json-008",
    "kind": "json",
    "rule": "$.data.chapters[*].name",
    "content": "{\"data\":{\"chapters\":[{\"name\":\"a\"},{\"name\":\"b\"}]}}",
    "expect": "[*].name 取每个元素 name。",
    "src": "$.data.chapters[*].name（真实书源）"
  },
  {
    "id": "json-009",
    "kind": "json",
    "rule": "$.results.list[*]",
    "content": "{\"results\":{\"list\":[\"x\",\"y\"]}}",
    "expect": "嵌套 results.list 数组展开。",
    "src": "$.results.list[*]（真实书源）"
  },
  {
    "id": "json-010",
    "kind": "json",
    "rule": "$..list[*].list[*]",
    "content": "{\"list\":[{\"list\":[\"a\",\"b\"]},{\"list\":[\"c\"]}]}",
    "expect": "递归 + 多重数组展开。",
    "src": "$..list[*].list[*]（真实书源嵌套）"
  },
  {
    "id": "json-011",
    "kind": "json",
    "rule": "$.data||$.data.data[*]",
    "content": "{\"data\":{\"data\":[\"d1\",\"d2\"]}}",
    "expect": "|| 回退：$.data 命中则用之。",
    "src": "$.data||$.data.data[*]||$.data[*]（真实书源回退）"
  },
  {
    "id": "json-012",
    "kind": "json",
    "rule": "$.a[*]%%$.b[*]",
    "content": "{\"a\":[\"a1\",\"a2\"],\"b\":[\"b1\",\"b2\"]}",
    "expect": "%% 交错：a1 b1 a2 b2。",
    "src": "$.a[*]%%$.b[*]（交错拼接，真实书源）"
  },
  {
    "id": "json-013",
    "kind": "json",
    "rule": "$.category&&$..score",
    "content": "{\"category\":\"玄幻\",\"data\":{\"score\":9.2}}",
    "expect": "&& 合并 category 与递归 score。",
    "src": "$.category&&$..score（真实书源组合）"
  },
  {
    "id": "json-014",
    "kind": "json",
    "rule": "$[?(@.type=='book')].name",
    "content": "{\"items\":[{\"type\":\"book\",\"name\":\"书A\"},{\"type\":\"movie\",\"name\":\"片B\"}]}",
    "expect": "过滤表达式保留 type==book 的 name。",
    "src": "$[?(@.type=='book')]（JsonPath 过滤）"
  },
  {
    "id": "json-015",
    "kind": "json",
    "rule": "$.data.chapters[?(@.vip==true)]",
    "content": "{\"data\":{\"chapters\":[{\"vip\":true,\"t\":\"v1\"},{\"vip\":false,\"t\":\"v2\"}]}}",
    "expect": "过滤 vip==true 的章节。",
    "src": "$.chapters[?(@.vip)]（真实书源 VIP 过滤）"
  },
  {
    "id": "json-016",
    "kind": "json",
    "rule": "$.books[?(@.price < 10)]",
    "content": "{\"books\":[{\"price\":8,\"n\":\"a\"},{\"price\":20,\"n\":\"b\"}]}",
    "expect": "数值比较过滤。",
    "src": "$.books[?(@.price<10)]（JsonPath 过滤）"
  },
  {
    "id": "json-017",
    "kind": "json",
    "rule": "$..authors[*]",
    "content": "{\"a\":{\"authors\":[\"张三\",\"李四\"]},\"b\":{\"authors\":[\"王五\"]}}",
    "expect": "递归收集所有 authors 数组。",
    "src": "$..authors[*]（递归数组）"
  },
  {
    "id": "json-018",
    "kind": "json",
    "rule": "$.store.book[*].price",
    "content": "{\"store\":{\"book\":[{\"price\":10},{\"price\":20}]}}",
    "expect": "嵌套数组字段。",
    "src": "$.store.book[*].price（标准 JsonPath 示例）"
  },
  {
    "id": "json-019",
    "kind": "json",
    "rule": "$.data.images[*]",
    "content": "{\"data\":{\"images\":[\"i1.jpg\",\"i2.jpg\"]}}",
    "expect": "图片数组展开。",
    "src": "$.model.images[*]（真实书源图集）"
  },
  {
    "id": "json-020",
    "kind": "json",
    "rule": "$.list[0:2]",
    "content": "{\"list\":[\"e0\",\"e1\",\"e2\",\"e3\"]}",
    "expect": "切片 [0:2) 取前两个。",
    "src": "$.list[0:2]（切片）"
  },
  {
    "id": "json-021",
    "kind": "json",
    "rule": "$.menu[*].items[*].title",
    "content": "{\"menu\":[{\"items\":[{\"title\":\"甲\"}]},{\"items\":[{\"title\":\"乙\"}]}]}",
    "expect": "深嵌套数组字段提取。",
    "src": "$.menu[*].items[*].title（真实书源）"
  },
  {
    "id": "json-022",
    "kind": "json",
    "rule": "$.a.b.c.d",
    "content": "{\"a\":{\"b\":{\"c\":{\"d\":\"深值\"}}}}",
    "expect": "深层路径取值。",
    "src": "$.a.b.c.d（深层路径）"
  },
  {
    "id": "json-023",
    "kind": "json",
    "rule": "$['book name']",
    "content": "{\"book name\":\"带空格键\",\"other\":1}",
    "expect": "带空格键需用 [''] 语法。",
    "src": "$['key with space']（特殊键）"
  },
  {
    "id": "json-024",
    "kind": "json",
    "rule": "$.numbers[-1]",
    "content": "{\"numbers\":[1,2,3,4]}",
    "expect": "负索引取末位元素。",
    "src": "$.numbers[-1]（负索引）"
  },
  {
    "id": "json-025",
    "kind": "json",
    "rule": "$.users[*].name",
    "content": "{\"users\":[{\"name\":\"甲\"},{\"name\":\"乙\"}]}",
    "expect": "用户数组取 name。",
    "src": "$.users[*].name（真实书源）"
  },
  {
    "id": "json-026",
    "kind": "json",
    "rule": "$.data.content",
    "content": "{\"data\":{\"content\":\"正文内容\"}}",
    "expect": "取正文内容字段。",
    "src": "$.data.content（ruleContent）"
  },
  {
    "id": "json-027",
    "kind": "json",
    "rule": "$.results[?(@.score > 90)]",
    "content": "{\"results\":[{\"score\":95,\"n\":\"a\"},{\"score\":80,\"n\":\"b\"}]}",
    "expect": "大于比较过滤。",
    "src": "$.results[?(@.score>90)]（过滤）"
  },
  {
    "id": "json-028",
    "kind": "json",
    "rule": "$.a[*]%%$.b[*]%%$.c[*]",
    "content": "{\"a\":[\"a1\"],\"b\":[\"b1\"],\"c\":[\"c1\"]}",
    "expect": "三路交错拼接。",
    "src": "$.a[*]%%$.b[*]%%$.c[*]（多路交错）"
  },
  {
    "id": "json-029",
    "kind": "json",
    "rule": "$.x.y[*].z",
    "content": "{\"x\":{\"y\":[{\"z\":\"v1\"},{\"z\":\"v2\"}]}}",
    "expect": "数组内取 z 字段。",
    "src": "$.x.y[*].z（真实书源）"
  },
  {
    "id": "json-030",
    "kind": "json",
    "rule": "$..*",
    "content": "{\"a\":1,\"b\":{\"c\":2}}",
    "expect": "递归取所有叶子值。",
    "src": "$..*（递归全部）"
  },
  {
    "id": "json-031",
    "kind": "json",
    "rule": "$.data.list[?(@.status=='active')]",
    "content": "{\"data\":{\"list\":[{\"status\":\"active\",\"v\":\"x\"},{\"status\":\"dead\",\"v\":\"y\"}]}}",
    "expect": "状态过滤。",
    "src": "$.data.list[?(@.status=='active')]（真实书源）"
  },
  {
    "id": "json-032",
    "kind": "json",
    "rule": "$.items[?(@.qty >= 2)]",
    "content": "{\"items\":[{\"qty\":3,\"n\":\"a\"},{\"qty\":1,\"n\":\"b\"}]}",
    "expect": "大于等于过滤。",
    "src": "$.items[?(@.qty>=2)]（过滤）"
  },
  {
    "id": "json-033",
    "kind": "json",
    "rule": "$.books[*].author",
    "content": "{\"books\":[{\"author\":\"甲\"},{\"author\":\"乙\"}]}",
    "expect": "数组对象字段提取。",
    "src": "$.books[*].author（真实书源）"
  },
  {
    "id": "json-034",
    "kind": "json",
    "rule": "$.data.chapters.length()",
    "content": "{\"data\":{\"chapters\":[\"c1\",\"c2\",\"c3\"]}}",
    "expect": "length() 函数取数组长度。",
    "src": "$.x.length()（JsonPath 函数）"
  }
]