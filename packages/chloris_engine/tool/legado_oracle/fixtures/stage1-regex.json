  },
  {
    "id": "regex-020",
    "kind": "regex",
    "rule": "(\\$\\{[^}]+\\})",
    "content": "模板 ${name} 与 ${title} 占位",
    "expect": "模板变量 ${...} 分组。",
    "src": "(\\$\\{[^}]+\\})（模板变量）"
  },
  {
    "id": "regex-021",
