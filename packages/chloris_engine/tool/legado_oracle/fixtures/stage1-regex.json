    "src": "/\\*([\\s\\S]*?)\\*/（块注释）"
  },
  {
    "id": "regex-023",
    "kind": "regex",
    "rule": "(\\w+):\\s*(.+)",
    "content": "title: 诡秘之主\nsub: 副标题",
    "expect": "无 multiline：. 不跨行，仅命中首行 title: 诡秘之主。",
    "src": "(\\w+):\\s*(.+)（无 multiline 首行）"
  },
  {
    "id": "regex-024",
    "kind": "regex",
    "rule": "第(.+?)章",
    "content": "第1卷第3章 开端",
    "expect": "非贪婪章节分组。",
    "src": "第(.+?)章（非贪婪）"
  },
  {
    "id": "regex-025",
